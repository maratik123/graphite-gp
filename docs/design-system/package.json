{
  "name": "graphite-gp-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Graphite GP design system — local bundle build",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=iife --global-name=GraphiteGP --loader:.jsx=jsx --jsx=automatic --outfile=ds_bundle.js",
    "watch": "npm run build -- --watch",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
